#!/bin/bash
# Upgrade: if this Mac is already enrolled, (re)register and start the LaunchDaemon.
# New install: enrollment needs a token, so it is a separate step:
#   sudo /usr/local/cnapp-agent/bin/cnapp-agent enroll --server https://... --token-stdin
#   sudo /usr/local/cnapp-agent/bin/cnapp-agent install
# An enrollment can also be supplied at install time (e.g. by your deployment
# tool) in /var/root/.cnapp-enroll as two lines: server URL, token. It is
# deleted after use.
bin=/usr/local/cnapp-agent/bin/cnapp-agent
state="/Library/Application Support/CNAPP Agent/state.json"
seed=/var/root/.cnapp-enroll

if [[ -f "$seed" ]]; then
  server="$(sed -n 1p "$seed")"
  token="$(sed -n 2p "$seed")"
  rm -f "$seed"
  if [[ -n "$server" && -n "$token" ]]; then
    printf '%s\n' "$token" | "$bin" enroll --server "$server" --token-stdin || exit 1
  fi
fi

if [[ -f "$state" ]]; then
  "$bin" install || exit 1
else
  echo "CNAPP agent installed but not enrolled. Run: sudo $bin enroll --server https://<your-cnapp> --token-stdin && sudo $bin install"
fi
exit 0
