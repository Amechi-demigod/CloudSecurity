#!/bin/bash
# Runs as root after the payload (/usr/local/cnapp-agent/bin/cnapp-agent) is installed.
#
# Enrollment, in order of precedence:
#  1. enroll.json next to this script: added by the CNAPP console when you
#     download a pre-configured package (Devices > Enroll > Download installer).
#  2. /var/root/.cnapp-enroll (legacy seed for deployment tools): lines
#     server URL, token, optional path of a PEM CA certificate. Deleted after use.
#  3. Nothing: the LaunchDaemon still starts and waits; enroll later with
#       sudo /usr/local/cnapp-agent/bin/cnapp-agent configure --server https://... --token-stdin
#     (e.g. from an MDM script) or `cnapp-agent enroll`.
# An already enrolled Mac is never re-enrolled (upgrades keep the device identity).
bin=/usr/local/cnapp-agent/bin/cnapp-agent
here="$(cd "$(dirname "$0")" && pwd)"
seed=/var/root/.cnapp-enroll

if [[ -f "$here/enroll.json" ]]; then
  "$bin" configure --from-file "$here/enroll.json" || exit 1
elif [[ -f "$seed" ]]; then
  server="$(sed -n 1p "$seed")"
  token="$(sed -n 2p "$seed")"
  ca="$(sed -n 3p "$seed")"
  rm -f "$seed"
  extra=()
  [[ -n "$ca" ]] && extra=(--ca-file "$ca")
  if [[ -n "$server" && -n "$token" ]]; then
    printf '%s\n' "$token" | "$bin" configure --server "$server" --token-stdin ${extra[@]+"${extra[@]}"} || exit 1
  fi
fi

"$bin" install --wait-for-enrollment || exit 1
exit 0
