# On-prem nginx site (mounted over the image's default template by
# deploy/onprem/docker-compose.prod.yml). Rendered at container start by the
# nginx image's entrypoint (envsubst of defined env vars only):
#   BACKEND_URL            http://backend:8000
#   RELAY_URL              http://relay:8001 (remote-session WebSockets)
#   CNAPP_HOSTNAME         canonical internal hostname (HTTP -> HTTPS redirect target)
#   NGINX_LOCAL_RESOLVERS  from /etc/resolv.conf (Docker's embedded DNS)
# nginx runs unprivileged: 8080 is published as 80, 8443 as 443.
#
# Access policy (rendered by cnapp-access.sh into conf.d/00-cnapp-access.conf and
# the cnapp-*.inc files): clients outside CNAPP_INTERNAL_CIDRS get 404 for
# everything except the endpoint-agent API (/api/agent/), which is what
# `cnapp-ctl public-agent enable` exposes to the internet. 404 rather than 403:
# an internet scanner learns nothing about what else runs here.

resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

# Plain HTTP: health probe for Docker, everything else -> HTTPS on the canonical name.
server {
  listen 8080 default_server;
  server_tokens off;
  include /etc/nginx/conf.d/cnapp-server.inc;

  # Port 80 is never published to the internet (cnapp-ctl keeps it internal-only).
  if ($cnapp_internal = 0) {
    return 404;
  }

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location / {
    return 301 https://${CNAPP_HOSTNAME}$request_uri;
  }
}

# Certificate per requested name (SNI). The canonical hostname gets server.crt;
# anything else - in particular clients connecting by IP address, which send no
# SNI (e.g. agents enrolled as https://10.10.11.57 before a switch to a DNS
# name with a public certificate) - gets legacy.crt. cnapp-ctl keeps
# legacy.crt a copy of server.crt unless `tls import-pfx` preserved the
# built-in certificate there (CNAPP_TLS_LEGACY_CERT=builtin).
map $ssl_server_name $cnapp_tls_cert {
  "${CNAPP_HOSTNAME}" server;
  default             legacy;
}

server {
  listen 8443 ssl default_server;
  http2 on;
  root /usr/share/nginx/html;
  server_tokens off;

  # Certificate = server certificate followed by any intermediates (full chain).
  ssl_certificate     /etc/nginx/tls/$cnapp_tls_cert.crt;
  ssl_certificate_key /etc/nginx/tls/$cnapp_tls_cert.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  include /etc/nginx/conf.d/cnapp-server.inc;
  # Outside the internal networks only the agent API exists.
  if ($cnapp_block) {
    return 404;
  }

  # Matches the backend's MAX_REQUEST_BYTES default (1 MiB)
  client_max_body_size 1m;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Signed agent release bundles uploaded by admins (Devices > Agent updates;
  # backend: AGENT_UPDATE_MAX_BUNDLE_BYTES). Session-authenticated admin API:
  # internal clients only (the server-level $cnapp_block already answers 404 to
  # everyone else; checked again here), never on the dedicated agent hostname
  # (that server block only includes the /api/agent/ locations). Agents
  # download updates through /api/agent/updates/ instead.
  location = /api/updates/releases {
    if ($cnapp_internal = 0) {
      return 404;
    }
    client_max_body_size 256m;
    client_body_timeout 120s;
    set $backend_upstream "${BACKEND_URL}";
    proxy_pass $backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_request_buffering on;
    proxy_read_timeout 300s;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Strict-Transport-Security;
  }

  # IT assets: CSV import and wipe / destruction certificate uploads (backend:
  # ASSET_IMPORT_MAX_BYTES 2 MiB, ASSET_CERTIFICATE_MAX_BYTES 5 MiB by default).
  # Session-authenticated user API: internal clients only, like /api/.
  location ~ ^/api/it-assets/(import$|certificates/) {
    if ($cnapp_internal = 0) {
      return 404;
    }
    client_max_body_size 8m;
    set $backend_upstream "${BACKEND_URL}";
    proxy_pass $backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Strict-Transport-Security;
  }

  # Remote-session viewer WebSocket (docs/DEVICE_MANAGEMENT.md#remote-sessions-windows):
  # the single-worker relay service pairs it with the device's socket. Internal
  # clients only, like the console; same-origin wss:// keeps the CSP at 'self'.
  # Long timeouts on this path only (the relay pings every 20 s).
  location ~ "^/api/remote/[0-9a-f]{32}$" {
    if ($cnapp_internal = 0) {
      return 404;
    }
    set $relay_upstream "${RELAY_URL}";
    proxy_pass $relay_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # The Host the browser sent, port included: the relay accepts the socket only
    # when the Origin is this exact origin ($host drops a non-default port).
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Strict-Transport-Security;
  }

  # API requests go to the backend (same origin for the browser: no CORS needed).
  location /api/ {
    set $backend_upstream "${BACKEND_URL}";
    proxy_pass $backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    # nginx is the edge: the client address it saw, never values a client sent.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Strict-Transport-Security;
  }

  # Endpoint-agent API (cnapp-agent-locations.inc): larger bodies for check-ins
  # and collect_logs bundles (8 MiB; backend AGENT_MAX_REQUEST_BYTES 6 MiB), per-IP
  # rate / connection limits for external clients, GET/HEAD/POST only.
  include /etc/nginx/conf.d/cnapp-agent-locations.inc;

  # Fingerprinted build assets can be cached forever.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    try_files $uri =404;
  }

  # SPA fallback for client-side routes; never cache index.html.
  location / {
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    try_files $uri /index.html;
  }
}
