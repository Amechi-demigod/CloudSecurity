# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# --- Core -------------------------------------------------------------------
# DATABASE_URL=sqlite:///./cnapp.db
# CORS_ORIGINS=http://localhost:5173

# --- Authentication -------------------------------------------------------------
# First admin, created on startup ONLY when no users exist yet. There is no
# default password: pick your own (12+ characters), sign in, then change it and
# remove ADMIN_PASSWORD from this file. Alternatively leave these empty and run
#   python -m app.cli create-user --email you@example.com --role admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
# Session cookie: Secure by default (https, GitHub Codespaces, and http://localhost
# in Chrome/Edge/Firefox). Set false only for plain-http access via another host.
COOKIE_SECURE=true
# SESSION_MAX_AGE_HOURS=8
# SESSION_IDLE_MINUTES=30
# Brute-force protection
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# LOGIN_RATE_LIMIT=20
# LOGIN_RATE_WINDOW_SECONDS=300
# Use the right-most X-Forwarded-For entry as client IP (only if the backend is
# reachable solely through your reverse proxy)
# TRUST_PROXY_HEADERS=false
# Serve /api/docs and /api/openapi.json without login
# API_DOCS_PUBLIC=false

# --- Simulated data mode (default ON) ----------------------------------------
SIMULATION_MODE=true
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=15
SIMULATOR_ATTACK_PROBABILITY=0.05
SEED=42

# --- Runtime sensor ingest ---------------------------------------------------
# POST /api/runtime/events requires "Authorization: Bearer <INGEST_API_TOKEN>".
# The sensor sends the same value from SENSOR_API_TOKEN. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Ingest is fail-closed: with no token the endpoint returns 503 unless
# INGEST_ALLOW_UNAUTHENTICATED=true (local development only).
INGEST_API_TOKEN=
INGEST_ALLOW_UNAUTHENTICATED=false
# Request body cap (bytes) and max events per ingest request
# MAX_REQUEST_BYTES=1048576
# MAX_EVENTS_PER_REQUEST=1000

# --- Azure read-only connector (opt-in) ---------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Comma-separated subscription IDs to scan
AZURE_SUBSCRIPTION_IDS=
# Use DefaultAzureCredential (az login / managed identity) when no secret is set
AZURE_USE_DEFAULT_CREDENTIAL=false
