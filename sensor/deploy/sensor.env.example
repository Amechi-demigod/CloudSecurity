# /etc/runtime-sensor/sensor.env  (chmod 600 - contains the API token)
SENSOR_API_URL=http://cnapp.example.internal:8000/api/runtime/events
SENSOR_API_TOKEN=change-me
# SENSOR_ID defaults to the hostname
#SENSOR_ID=vm-web-01
SENSOR_COLLECTORS=process,network,file,library
SENSOR_POLL_INTERVAL=2
SENSOR_LIBRARY_INTERVAL=120
SENSOR_EBPF=auto
# list (native v1.0 array, default) | envelope | cnapp-mvp (legacy backend format, drops library_loaded)
SENSOR_PAYLOAD_FORMAT=list
# Optional cloud identity override (otherwise detected from DMI)
#SENSOR_CLOUD_PROVIDER=azure
#SENSOR_CLOUD_RESOURCE_ID=/subscriptions/.../virtualMachines/vm-web-01
