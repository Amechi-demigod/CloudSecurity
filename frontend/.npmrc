# typescript-eslint has a peer dependency on typescript <6.1, but the app builds
# with TypeScript 7. ESLint uses the TS 6 API from @typescript/typescript6 instead
# (see eslint.config.js), so the peer-range conflict is expected. Because peers
# are not auto-installed in this mode, list runtime peers (e.g. react-is for
# recharts) explicitly in package.json.
legacy-peer-deps=true
