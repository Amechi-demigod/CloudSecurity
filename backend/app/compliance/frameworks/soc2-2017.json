   {"id": "CC2.2", "title": "Internal communication"},
   {"id": "CC2.3", "title": "External communication"}
  ]},
  {"id": "CC3", "title": "Risk assessment", "controls": [
   {"id": "CC3.1", "title": "Objectives specified"},
   {"id": "CC3.2", "title": "Risks identified and analysed"},
   {"id": "CC3.3", "title": "Fraud risk considered"},
   {"id": "CC3.4", "title": "Significant changes assessed"}
  ]},
  {"id": "CC4", "title": "Monitoring activities", "controls": [
   {"id": "CC4.1", "title": "Ongoing and separate evaluations"},
   {"id": "CC4.2", "title": "Deficiencies communicated"}
  ]},
  {"id": "CC5", "title": "Control activities", "controls": [
