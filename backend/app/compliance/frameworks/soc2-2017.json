   {"id": "CC5.3", "title": "Policies and procedures deployed"}
  ]},
  {"id": "CC6", "title": "Logical and physical access", "controls": [
   {"id": "CC6.1", "title": "Logical access security over protected assets", "checks": ["@privileged-access", "@mfa", "@service-authentication", "@encryption-at-rest-cloud", "@key-management"], "coverage": "partial"},
   {"id": "CC6.2", "title": "User registration and removal", "checks": ["@account-lifecycle"], "coverage": "partial"},
   {"id": "CC6.3", "title": "Role-based access and least privilege", "checks": ["@privileged-access", "@account-lifecycle"], "coverage": "partial"},
   {"id": "CC6.4", "title": "Physical access restricted"},
   {"id": "CC6.5", "title": "Protection at asset disposal"},
   {"id": "CC6.6", "title": "Protection against threats from outside the boundary", "checks": ["@public-network-exposure", "@public-data-access", "@network-threat-protection"], "coverage": "partial"},
   {"id": "CC6.7", "title": "Data protected in transmission and movement", "checks": ["@encryption-in-transit", "endpoint:disk_encryption"], "coverage": "partial"},
   {"id": "CC6.8", "title": "Unauthorised or malicious software prevented or detected", "checks": ["@endpoint-malware", "@endpoint-hardening"], "coverage": "partial"}
  ]},
  {"id": "CC7", "title": "System operations", "controls": [
   {"id": "CC7.1", "title": "Configuration changes and vulnerabilities detected", "checks": ["@vulnerability-management", "@secure-config-cloud", "@eol-software", "inventory:cloud_scan"], "coverage": "partial"},
   {"id": "CC7.2", "title": "System components monitored for anomalies", "checks": ["@cloud-logging", "@network-threat-protection", "endpoint:checkin"], "coverage": "partial"},
   {"id": "CC7.3", "title": "Security events evaluated"},
   {"id": "CC7.4", "title": "Incident response"},
   {"id": "CC7.5", "title": "Recovery from incidents"}
  ]},
  {"id": "CC8", "title": "Change management", "controls": [
   {"id": "CC8.1", "title": "Changes authorised, tested and approved"}
  ]},
  {"id": "CC9", "title": "Risk mitigation", "controls": [
   {"id": "CC9.1", "title": "Business disruption risks mitigated"},
   {"id": "CC9.2", "title": "Vendor and partner risk managed"}
  ]}
 ]
