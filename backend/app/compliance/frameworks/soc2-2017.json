   {"id": "CC1.2", "title": "Board oversight"},
   {"id": "CC1.3", "title": "Structures, reporting lines and authority"},
   {"id": "CC1.4", "title": "Commitment to competence"},
   {"id": "CC1.5", "title": "Accountability"}
  ]},
  {"id": "CC2", "title": "Communication and information", "controls": [
