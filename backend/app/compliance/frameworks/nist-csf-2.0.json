{
 "id": "nist-csf-2.0",
 "name": "NIST Cybersecurity Framework 2.0",
 "short_name": "NIST CSF",
 "version": "2.0",
 "mapping_version": 1,
 "publisher": "NIST",
 "notice": "Subcategory identifiers with short summaries (NIST CSF 2.0 is a public-domain US government work).",
 "groups": [
  {"id": "GV", "title": "Govern", "controls": [
   {"id": "GV.OC-01", "title": "Mission understood and informs risk management"},
   {"id": "GV.OC-02", "title": "Stakeholder needs and expectations understood"},
   {"id": "GV.OC-03", "title": "Legal, regulatory and contractual requirements managed"},
   {"id": "GV.OC-04", "title": "Critical objectives, capabilities and services understood"},
   {"id": "GV.OC-05", "title": "Dependencies on the organisation understood"},
   {"id": "GV.RM-01", "title": "Risk management objectives agreed"},
   {"id": "GV.RM-02", "title": "Risk appetite and tolerance stated"},
   {"id": "GV.RM-03", "title": "Cybersecurity risk part of enterprise risk management"},
   {"id": "GV.RM-04", "title": "Strategic direction for risk response set"},
   {"id": "GV.RM-05", "title": "Lines of communication for risks established"},
   {"id": "GV.RM-06", "title": "Standardised method for risk calculation"},
   {"id": "GV.RM-07", "title": "Strategic opportunities included in risk discussions"},
   {"id": "GV.RR-01", "title": "Leadership accountable for cybersecurity risk"},
   {"id": "GV.RR-02", "title": "Roles, responsibilities and authorities established"},
   {"id": "GV.RR-03", "title": "Adequate resources allocated"},
   {"id": "GV.RR-04", "title": "Cybersecurity included in HR practices"},
   {"id": "GV.PO-01", "title": "Cybersecurity policy established and communicated"},
   {"id": "GV.PO-02", "title": "Policy reviewed and updated"},
   {"id": "GV.OV-01", "title": "Strategy outcomes reviewed"},
   {"id": "GV.OV-02", "title": "Strategy reviewed for coverage"},
   {"id": "GV.OV-03", "title": "Risk management performance evaluated"},
   {"id": "GV.SC-01", "title": "Supply chain risk programme established"},
   {"id": "GV.SC-02", "title": "Supplier roles and responsibilities established"},
   {"id": "GV.SC-03", "title": "Supply chain risk integrated into risk management"},
   {"id": "GV.SC-04", "title": "Suppliers known and prioritised"},
   {"id": "GV.SC-05", "title": "Supplier requirements in contracts"},
   {"id": "GV.SC-06", "title": "Due diligence before supplier relationships"},
   {"id": "GV.SC-07", "title": "Supplier risks assessed and monitored"},
   {"id": "GV.SC-08", "title": "Suppliers included in incident activities"},
   {"id": "GV.SC-09", "title": "Supply chain practices integrated and monitored"},
   {"id": "GV.SC-10", "title": "Provisions for after a supplier relationship ends"}
  ]},
  {"id": "ID", "title": "Identify", "controls": [
   {"id": "ID.AM-01", "title": "Hardware inventories maintained", "checks": ["inventory:directory_sync", "directory:not_managed", "directory:unknown_to_directory", "endpoint:checkin"], "coverage": "partial"},
   {"id": "ID.AM-02", "title": "Software, services and systems inventories maintained", "checks": ["inventory:cloud_scan"], "coverage": "partial", "note": "Cloud resources only; installed software is inventoried by the agent but not assessed here."},
   {"id": "ID.AM-03", "title": "Network communication and data flows represented"},
   {"id": "ID.AM-04", "title": "Supplier services inventoried"},
   {"id": "ID.AM-05", "title": "Assets prioritised"},
   {"id": "ID.AM-07", "title": "Data inventories maintained"},
   {"id": "ID.AM-08", "title": "Assets managed through their life cycle", "checks": ["@eol-software", "directory:stale_computer"], "coverage": "partial"},
   {"id": "ID.RA-01", "title": "Asset vulnerabilities identified and recorded", "checks": ["@vulnerability-management", "inventory:cloud_scan"], "coverage": "partial"},
   {"id": "ID.RA-02", "title": "Threat intelligence received"},
   {"id": "ID.RA-03", "title": "Threats identified and recorded"},
   {"id": "ID.RA-04", "title": "Impacts and likelihoods identified"},
   {"id": "ID.RA-05", "title": "Risks prioritised for response"},
   {"id": "ID.RA-06", "title": "Risk responses chosen and tracked"},
   {"id": "ID.RA-07", "title": "Changes and exceptions managed"},
   {"id": "ID.RA-08", "title": "Vulnerability disclosure processes established"},
   {"id": "ID.RA-09", "title": "Hardware and software authenticity assessed"},
   {"id": "ID.RA-10", "title": "Critical suppliers assessed before acquisition"},
   {"id": "ID.IM-01", "title": "Improvements identified from evaluations"},
   {"id": "ID.IM-02", "title": "Improvements identified from tests and exercises"},
   {"id": "ID.IM-03", "title": "Improvements identified from operations"},
   {"id": "ID.IM-04", "title": "Incident response and other plans maintained"}
  ]},
  {"id": "PR", "title": "Protect", "controls": [
   {"id": "PR.AA-01", "title": "Identities and credentials managed", "checks": ["@account-lifecycle", "@password-policy", "cloud:AWS-IAM-005", "cloud:GCP-IAM-002"], "coverage": "partial"},
   {"id": "PR.AA-02", "title": "Identities proofed and bound to credentials"},
   {"id": "PR.AA-03", "title": "Users, services and hardware authenticated", "checks": ["@mfa", "@service-authentication"], "coverage": "partial"},
   {"id": "PR.AA-04", "title": "Identity assertions protected and verified"},
   {"id": "PR.AA-05", "title": "Access permissions follow least privilege", "checks": ["@privileged-access", "@public-data-access"], "coverage": "partial"},
   {"id": "PR.AA-06", "title": "Physical access managed"},
   {"id": "PR.AT-01", "title": "Personnel made aware and trained"},
   {"id": "PR.AT-02", "title": "Specialised roles trained"},
   {"id": "PR.DS-01", "title": "Data at rest protected", "checks": ["@encryption-at-rest-cloud", "endpoint:disk_encryption", "@public-data-access"], "coverage": "partial"},
   {"id": "PR.DS-02", "title": "Data in transit protected", "checks": ["@encryption-in-transit"], "coverage": "partial"},
   {"id": "PR.DS-10", "title": "Data in use protected"},
   {"id": "PR.DS-11", "title": "Backups created, protected and tested", "checks": ["@backup"], "coverage": "partial", "note": "Backup settings only; restore tests need manual evidence."},
   {"id": "PR.PS-01", "title": "Configuration management practices applied", "checks": ["@secure-config-cloud", "@endpoint-hardening"], "coverage": "partial"},
   {"id": "PR.PS-02", "title": "Software maintained, replaced and removed", "checks": ["@eol-software", "endpoint:os_updates", "vuln:critical_sla", "vuln:high_sla"], "coverage": "partial"},
   {"id": "PR.PS-03", "title": "Hardware maintained, replaced and removed"},
   {"id": "PR.PS-04", "title": "Log records generated", "checks": ["@cloud-logging"], "coverage": "partial"},
   {"id": "PR.PS-05", "title": "Unauthorised software prevented", "checks": ["endpoint:gatekeeper"], "coverage": "partial", "note": "macOS Gatekeeper only."},
   {"id": "PR.PS-06", "title": "Secure software development practices"},
   {"id": "PR.IR-01", "title": "Networks protected from unauthorised access", "checks": ["@public-network-exposure"], "coverage": "partial"},
   {"id": "PR.IR-02", "title": "Technology protected from environmental threats"},
   {"id": "PR.IR-03", "title": "Resilience mechanisms implemented"},
   {"id": "PR.IR-04", "title": "Adequate capacity maintained"}
  ]},
  {"id": "DE", "title": "Detect", "controls": [
   {"id": "DE.CM-01", "title": "Networks and network services monitored", "checks": ["@network-threat-protection"], "coverage": "partial"},
   {"id": "DE.CM-02", "title": "Physical environment monitored"},
   {"id": "DE.CM-03", "title": "Personnel activity and technology usage monitored"},
   {"id": "DE.CM-06", "title": "External service provider activities monitored"},
   {"id": "DE.CM-09", "title": "Computing hardware, software and data monitored", "checks": ["@endpoint-malware", "endpoint:checkin"], "coverage": "partial"},
   {"id": "DE.AE-02", "title": "Adverse events analysed"},
   {"id": "DE.AE-03", "title": "Information correlated from multiple sources"},
   {"id": "DE.AE-04", "title": "Impact and scope of events understood"},
   {"id": "DE.AE-06", "title": "Information on adverse events shared"},
   {"id": "DE.AE-07", "title": "Threat intelligence integrated into analysis"},
   {"id": "DE.AE-08", "title": "Incidents declared against criteria"}
  ]},
  {"id": "RS", "title": "Respond", "controls": [
   {"id": "RS.MA-01", "title": "Incident response plan executed"},
   {"id": "RS.MA-02", "title": "Incident reports triaged and validated"},
   {"id": "RS.MA-03", "title": "Incidents categorised and prioritised"},
   {"id": "RS.MA-04", "title": "Incidents escalated as needed"},
   {"id": "RS.MA-05", "title": "Criteria for starting recovery applied"},
   {"id": "RS.AN-03", "title": "Incident analysis performed"},
   {"id": "RS.AN-06", "title": "Investigation actions recorded"},
   {"id": "RS.AN-07", "title": "Incident data and metadata preserved"},
   {"id": "RS.AN-08", "title": "Incident magnitude estimated"},
   {"id": "RS.CO-02", "title": "Stakeholders notified of incidents"},
   {"id": "RS.CO-03", "title": "Information shared with stakeholders"},
   {"id": "RS.MI-01", "title": "Incidents contained"},
   {"id": "RS.MI-02", "title": "Incidents eradicated"}
  ]},
  {"id": "RC", "title": "Recover", "controls": [
   {"id": "RC.RP-01", "title": "Recovery plan executed"},
   {"id": "RC.RP-02", "title": "Recovery actions selected and performed"},
   {"id": "RC.RP-03", "title": "Integrity of backups verified before restoring"},
   {"id": "RC.RP-04", "title": "Post-incident operational norms established"},
   {"id": "RC.RP-05", "title": "Integrity of restored assets verified"},
   {"id": "RC.RP-06", "title": "End of recovery declared"},
   {"id": "RC.CO-03", "title": "Recovery progress communicated"},
   {"id": "RC.CO-04", "title": "Public updates on recovery shared"}
  ]}
 ]
}
